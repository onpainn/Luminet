                    Case "col"
                        outNew(r, mapNew(i)(0)) = dataArr(srcRow, mapNew(i)(2))
                    
                    Case "ext"
                        email = LCase(dataArr(srcRow, 5))
                        
                        If dictExt.exists(email) Then
                            extRow = dictExt(email)
                            outNew(r, mapNew(i)(0)) = extArr(extRow, mapNew(i)(2))
                        End If
                        
                End Select
                
            Next i
            
        End If
        
    Next key
    
    ' -------------------------
    ' FIRED LIST
    ' -------------------------
    r = 0
    
    For Each key In dictCur.keys
        
        If dictNew.exists(key) Then
            
            If LCase(oldStatus(key)) <> "уволен" And _
               LCase(dataArr(dictNew(key), 9)) = "уволен" Then
                
                r = r + 1
                srcRow = dictNew(key)
                
                For i = 0 To UBound(mapFired)
                    
                    Select Case mapFired(i)(1)
                        
                        Case "counter"
                            outFired(r, mapFired(i)(0)) = r
                        
                        Case "col"
                            outFired(r, mapFired(i)(0)) = dataArr(srcRow, mapFired(i)(2))
                        
                        Case "ext"
                            email = LCase(dataArr(srcRow, 5))
                            
                            If dictExt.exists(email) Then
                                extRow = dictExt(email)
                                outFired(r, mapFired(i)(0)) = extArr(extRow, mapFired(i)(2))
                            End If
                            
                    End Select
                    
                Next i
                
            End If
            
        End If
        
    Next key
    
    ' -------------------------
    ' WRITE ONCE (FAST!)
    ' -------------------------
    If r > 0 Then
        wsNew.Range("A2").Resize(UBound(outNew, 1), UBound(outNew, 2)).Value = outNew
        wsFired.Range("A2").Resize(UBound(outFired, 1), UBound(outFired, 2)).Value = outFired
    End If
    
    ' -------------------------
    ' CLEANUP
    ' -------------------------
    wbDB.Close False
    wbExt.Close False
    wbCur.Save
    wbCur.Close
    
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    Application.EnableEvents = True
    
    MsgBox "FAST DONE"

End Sub







