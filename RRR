Public Function ExtractTwoDates(ByVal txt As Variant) As Variant

    Dim regEx As Object, matches As Object
    Dim result(1 To 2) As String
    Dim s As String

    result(1) = ""
    result(2) = ""

    If IsError(txt) Or IsNull(txt) Or IsEmpty(txt) Then
        ExtractTwoDates = result
        Exit Function
    End If

    s = Trim(CStr(txt))
    If s = "" Then
        ExtractTwoDates = result
        Exit Function
    End If

    Set regEx = CreateObject("VBScript.RegExp")
    regEx.Pattern = "(\d{1,2}[\.\-/ ](?:\d{1,2}|[А-Яа-я]+)[\.\-/ ]\d{2,4})"
    regEx.Global = True
    regEx.IgnoreCase = True

    If regEx.Test(s) Then
        Set matches = regEx.Execute(s)

        If matches.Count >= 1 Then result(1) = matches(0)
        If matches.Count >= 2 Then result(2) = matches(1)
    End If

    ExtractTwoDates = result

End Function





