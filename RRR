Public Function IsAbsentOver10Days(ByVal v As Variant) As Boolean

    ' нет даты → считаем как >10 дней
    If IsError(v) Or IsEmpty(v) Or v = "" Then
        IsAbsentOver10Days = True
        Exit Function
    End If

    ' если это дата
    If IsDate(v) Then
        If Date - CDate(v) > 10 Then
            IsAbsentOver10Days = True
        Else
            IsAbsentOver10Days = False
        End If
        Exit Function
    End If

    ' мусор → тоже считаем как >10 дней
    IsAbsentOver10Days = True

End Function

