Sub UpdateList(ws As Worksheet, map As Variant, categories As Variant, statuses As Variant, includeStatus As Boolean)

    Dim wbDB As Workbook, wbExt As Workbook
    Dim wsDB As Worksheet, wsExt As Worksheet
    
    Dim dataArr, extArr
    Dim dictExt As Object
    
    Dim i As Long, outRow As Long
    Dim email As String, statusVal As String, categoryVal As String
    
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    Application.EnableEvents = False
    
    Set wbDB = Workbooks.Open("C:\Files\Database.xlsx", ReadOnly:=True)
    Set wbExt = Workbooks.Open("C:\Files\Ext.xlsx", ReadOnly:=True)
    
    Set wsDB = wbDB.Sheets(1)
    Set wsExt = wbExt.Sheets(1)
    
    dataArr = wsDB.Range("A2").CurrentRegion.Value
    
    ' ========= EXT =========
    Dim lastRow As Long
    lastRow = wsExt.Cells(wsExt.Rows.Count, 15).End(xlUp).Row
    
    extArr = wsExt.Range("O18:Z" & lastRow).Value
    
    Set dictExt = CreateObject("Scripting.Dictionary")
    
    For i = 1 To UBound(extArr, 1)
        email = Normalize(extArr(i, 1))
        If email <> "" Then dictExt(email) = i
    Next i
    
    ' ========= ЧИСТИМ ЛИСТ =========
    ws.Rows("2:" & ws.Rows.Count).ClearContents
    
    outRow = 1
    
    ' ========= ОСНОВНОЙ ЦИКЛ =========
    For i = 1 To UBound(dataArr, 1)
        
        email = Normalize(dataArr(i, 5))
        statusVal = LCase(Trim(dataArr(i, 10)))
        categoryVal = LCase(Trim(dataArr(i, 2)))
        
        If email = "" Then GoTo NextI
        
        ' --- фильтр категории
        If Not InArray(categoryVal, categories) Then GoTo NextI
        
        ' --- фильтр статуса
        If includeStatus Then
            If Not InArray(statusVal, statuses) Then GoTo NextI
        Else
            If InArray(statusVal, statuses) Then GoTo NextI
        End If
        
        ' --- запись
        outRow = outRow + 1
        
        WriteByMap ws, outRow, map, dataArr, extArr, dictExt, i
        
NextI:
    Next i
    
    wbDB.Close False
    wbExt.Close False
    
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    Application.EnableEvents = True

End Sub


