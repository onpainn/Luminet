Private Sub WriteByMap(ws As Worksheet, r As Long, map As Variant, dataArr, extArr, dictExt As Object, srcRow As Long)

    Dim j As Long
    Dim email As String
    Dim extRow As Long
    
    email = Normalize(dataArr(srcRow, 5))
    
    For j = 0 To UBound(map)
        
        Select Case map(j)(1)
            
            Case "counter"
                ws.Cells(r, map(j)(0)).Value = r - 1
            
            Case "col"
                ws.Cells(r, map(j)(0)).Value = dataArr(srcRow, map(j)(2))
            
            Case "ext"
                If dictExt.exists(email) Then
                    extRow = dictExt(email)
                    ws.Cells(r, map(j)(0)).Value = extArr(extRow, map(j)(2))
                End If
            
            Case "manual"
                ws.Cells(r, map(j)(0)).Value = ""
                
        End Select
        
    Next j

End Sub


