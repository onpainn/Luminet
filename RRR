        Array(3, "col", 6), _
        Array(4, "col", 4), _
        Array(5, "col", 5), _
        Array(6, "col", 23), _
        Array(7, "col", 2), _
        Array(8, "col", 24), _
        Array(9, "col", 8), _
        Array(10, "ext", 2), _
        Array(11, "ext", 10) _
    )
    
    mapNew = Array( _
        Array(1, "counter", 0), _
        Array(2, "col", 3), _
        Array(3, "col", 6), _
        Array(4, "col", 4), _
        Array(5, "col", 5), _
        Array(6, "col", 23), _
        Array(7, "col", 2), _
        Array(8, "ext", 2), _
