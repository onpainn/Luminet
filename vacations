Dim wbDB As Workbook
Dim dbPath As String

dbPath = ThisWorkbook.Path & "\" & Dir(ThisWorkbook.Path & "\*.xlsx")

Set wbDB = Workbooks.Open(dbPath)






Option Explicit

Sub КтоВыходитСегодня()

    Dim wbDB As Workbook
    
    Dim wsMain As Worksheet
    Dim wsEvents As Worksheet
    
    Dim lastRowMain As Long
    Dim lastRowEvents As Long
    
    Dim dict As Object
    Dim latestDates As Object
    
    Dim i As Long
    
    Dim empID As String
    Dim statusText As String
    
    Dim returnDate As Variant
    
    Dim resultText As String
    
    ' ===== ПОДКЛЮЧЕНИЕ БД =====
    
    On Error Resume Next
    Set wbDB = Workbooks("ГлавнаяБД.xlsx")
    On Error GoTo 0
    
    If wbDB Is Nothing Then
        Set wbDB = Workbooks.Open("D:\HR\ГлавнаяБД.xlsx")
    End If
    
    Set wsMain = wbDB.Sheets(2)
    Set wsEvents = wbDB.Sheets(3)
    
    ' ===== СЛОВАРИ =====
    
    Set dict = CreateObject("Scripting.Dictionary")
    Set latestDates = CreateObject("Scripting.Dictionary")
    
    ' ===== СОБИРАЕМ ЛЮДЕЙ В ОТПУСКЕ =====
    
    lastRowMain = wsMain.Cells(wsMain.Rows.Count, 5).End(xlUp).Row
    
    For i = 2 To lastRowMain
    
        statusText = LCase(Trim(wsMain.Cells(i, 9).Value))
        
        If statusText = "отпуск" Then
        
            empID = NormalizeID(wsMain.Cells(i, 5).Value)
            
            If empID <> "" Then
                dict(empID) = True
            End If
            
        End If
        
    Next i
    
    ' ===== ИЩЕМ ПОСЛЕДНИЕ СОБЫТИЯ =====
    
    lastRowEvents = wsEvents.Cells(wsEvents.Rows.Count, 3).End(xlUp).Row
    
    For i = 2 To lastRowEvents
    
        empID = NormalizeID(wsEvents.Cells(i, 3).Value)
        
        If dict.exists(empID) Then
        
            returnDate = wsEvents.Cells(i, 5).Value
            
            If IsDate(returnDate) Then
            
                latestDates(empID) = CDate(returnDate)
                
            End If
            
        End If
        
    Next i
    
    ' ===== ПРОВЕРКА НА СЕГОДНЯ =====
    
    resultText = ""
    
    Dim key As Variant
    
    For Each key In latestDates.Keys
    
        If latestDates(key) = Date Then
        
            resultText = resultText & key & vbCrLf
            
        End If
        
    Next key
    
    ' ===== ВЫВОД =====
    
    If resultText = "" Then
    
        MsgBox "Сегодня никто не выходит из отпуска", vbInformation
        
    Else
    
        MsgBox "Сегодня выходят из отпуска:" & vbCrLf & vbCrLf & resultText, vbInformation
        
    End If

End Sub


Function NormalizeID(txt As String) As String

    txt = LCase(txt)
    txt = Replace(txt, " ", "")
    txt = Trim(txt)
    
    NormalizeID = txt

End Function









Option Explicit

Sub ДобавитьСобытие()

    Dim wbDB As Workbook
    Dim wsEvents As Worksheet
    Dim wsMain As Worksheet
    
    Dim wsForm As Worksheet
    
    Dim lastRowEvents As Long
    Dim lastRowMain As Long
    
    Dim eventDate As Variant
    Dim employeeID As String
    Dim eventDesc As String
    Dim returnDate As Variant
    
    Dim normalizedID As String
    
    Dim i As Long
    Dim foundRow As Long
    
    Dim nextEventNumber As Long
    
    ' === УКАЗАТЬ ИМЯ ФАЙЛА ГЛАВНОЙ БД ===
    Set wbDB = Workbooks("ГлавнаяБД.xlsx")
    
    ' Листы главной БД
    Set wsMain = wbDB.Sheets(2)
    Set wsEvents = wbDB.Sheets(3)
    
    ' Лист формы (текущий файл)
    Set wsForm = ThisWorkbook.Sheets(1)
    
    ' ===== ЧТЕНИЕ ФОРМЫ =====
    
    eventDate = wsForm.Range("B2").Value
    employeeID = wsForm.Range("B3").Value
    eventDesc = LCase(Trim(wsForm.Range("B4").Value))
    returnDate = wsForm.Range("B5").Value
    
    ' ===== НОРМАЛИЗАЦИЯ ID =====
    
    normalizedID = NormalizeID(employeeID)
    
    ' ===== ДОБАВЛЕНИЕ СОБЫТИЯ =====
    
    lastRowEvents = wsEvents.Cells(wsEvents.Rows.Count, 1).End(xlUp).Row + 1
    
    ' № события
    If lastRowEvents = 2 Then
        nextEventNumber = 1
    Else
        nextEventNumber = wsEvents.Cells(lastRowEvents - 1, 1).Value + 1
    End If
    
    ' Запись события
    wsEvents.Cells(lastRowEvents, 1).Value = nextEventNumber
    wsEvents.Cells(lastRowEvents, 2).Value = eventDate
    wsEvents.Cells(lastRowEvents, 3).Value = normalizedID
    wsEvents.Cells(lastRowEvents, 4).Value = eventDesc
    wsEvents.Cells(lastRowEvents, 5).Value = returnDate
    
    ' ===== ПОИСК ID В ГЛАВНОЙ БД =====
    
    lastRowMain = wsMain.Cells(wsMain.Rows.Count, 5).End(xlUp).Row
    
    foundRow = 0
    
    For i = 2 To lastRowMain
    
        If NormalizeID(wsMain.Cells(i, 5).Value) = normalizedID Then
            foundRow = i
            Exit For
        End If
        
    Next i
    
    ' ===== ОБНОВЛЕНИЕ СТАТУСА =====
    
    If foundRow > 0 Then
    
        If eventDesc = "отпуск" Then
            wsMain.Cells(foundRow, 9).Value = "Отпуск"
            
        ElseIf eventDesc = "из отпуска" Then
            wsMain.Cells(foundRow, 9).Value = "Работает"
            
        End If
        
    Else
    
        MsgBox "ID не найден в главной базе!", vbExclamation
        
    End If
    
    ' ===== ОЧИСТКА ФОРМЫ =====
    
    wsForm.Range("B2:B5").ClearContents
    
    MsgBox "Событие успешно добавлено!", vbInformation

End Sub


Function NormalizeID(txt As String) As String

    txt = LCase(txt)
    txt = Replace(txt, " ", "")
    txt = Trim(txt)
    
    NormalizeID = txt

End Function