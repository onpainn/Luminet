Private Function GetOldValue(arr As Variant, row As Long, col As Long) As Variant
    
    If row <= UBound(arr, 1) And col <= UBound(arr, 2) Then
        GetOldValue = arr(row, col)
    Else
        GetOldValue = ""
    End If

End Function














