Option Explicit

Dim RemindersShown As Object

' =========================
' NORMALIZE TIME
' =========================
Function NormTime(v As Variant) As String
    If IsDate(v) Then
        NormTime = Format(CDate(v), "HH:MM")
    Else
        NormTime = Format(Trim(v), "HH:MM")
    End If
End Function

' =========================
' GET WEEKDAY
' =========================
Function GetWeekDayName(d As Date) As String
    Select Case Weekday(d, vbMonday)
        Case 1: GetWeekDayName = "понедельник"
        Case 2: GetWeekDayName = "вторник"
        Case 3: GetWeekDayName = "среда"
        Case 4: GetWeekDayName = "четверг"
        Case 5: GetWeekDayName = "пятница"
        Case 6: GetWeekDayName = "суббота"
        Case 7: GetWeekDayName = "воскресенье"
    End Select
End Function

' =========================
' MAIN CHECK
' =========================
Sub CheckReminders()

    Dim ws As Worksheet
    Set ws = ThisWorkbook.Sheets(1)

    If RemindersShown Is Nothing Then
        Set RemindersShown = CreateObject("Scripting.Dictionary")
    End If

    Dim lastRow As Long
    lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row

    Dim currentTime As String
    Dim currentDate As String
    Dim currentWeekDay As String

    currentTime = Format(Time, "HH:MM")
    currentDate = Format(Date, "dd.mm.yyyy")
    currentWeekDay = GetWeekDayName(Date)

    Dim i As Long

    For i = 2 To lastRow

        If Trim(ws.Cells(i, "A").Value) = "" Then GoTo NextRow
        If Trim(ws.Cells(i, "M").Value) = "+" Then GoTo NextRow

        Dim taskName As String
        Dim ruleDate As String
        Dim ruleTime As String

        taskName = ws.Cells(i, "D").Value
        ruleDate = LCase(Trim(ws.Cells(i, "K").Value))
        ruleTime = ws.Cells(i, "L").Value

        ruleTime = NormTime(ruleTime)

        ' =========================
        ' EVERY DAY
        ' =========================
        If InStr(ruleDate, "каждый день") > 0 Then
            Call CheckTimes(taskName, i, ruleTime, currentTime)
        End If

        ' =========================
        ' WEEKLY
        ' =========================
        If InStr(ruleDate, "каждую неделю") > 0 Then

            Dim part As String
            part = Replace(ruleDate, "каждую неделю", "")

            Dim arr() As String
            arr = Split(part, ",")

            Dim d As Variant
            For Each d In arr
                If Trim(d) = currentWeekDay Then
                    Call CheckTimes(taskName, i, ruleTime, currentTime)
                End If
            Next d

        End If

        ' =========================
        ' DATE LIST
        ' =========================
        If InStr(ruleDate, ".") > 0 Then

            Dim arrD() As String
            arrD = Split(ruleDate, ",")

            Dim arrT() As String
            arrT = Split(ruleTime, ",")

            Dim dd As Variant
            Dim tt As Variant

            For Each dd In arrD

                If Trim(dd) = currentDate Then

                    For Each tt In arrT
                        Call CheckSmart(taskName, i, NormTime(tt), currentTime)
                    Next tt

                End If

            Next dd

        End If

NextRow:
    Next i

End Sub

' =========================
' CHECK EXACT + 1 HOUR
' =========================
Sub CheckSmart(taskName As String, rowIndex As Long, eventTime As String, currentTime As String)

    Dim tEvent As Date
    Dim tNow As Date

    tEvent = TimeValue(eventTime)
    tNow = TimeValue(currentTime)

    ' EXACT
    If Format(tNow, "HH:MM") = Format(tEvent, "HH:MM") Then
        Call Notify(taskName, rowIndex, eventTime, "ВОВРЕМЯ")
    End If

    ' 1 HOUR BEFORE
    If Format(tNow, "HH:MM") = Format(DateAdd("h", -1, tEvent), "HH:MM") Then
        Call Notify(taskName, rowIndex, eventTime, "ЗА 1 ЧАС")
    End If

End Sub

' =========================
' WINDOWS TOAST NOTIFICATION
' =========================
Sub Notify(taskName As String, rowIndex As Long, eventTime As String, notifyType As String)

    Dim key As String
    key = rowIndex & "_" & eventTime & "_" & notifyType

    If RemindersShown.Exists(key) Then Exit Sub
    RemindersShown.Add key, True

    ' Windows Toast via PowerShell
    Dim msg As String
    msg = "Задача: " & taskName & " | Время: " & eventTime & " | " & notifyType

    Dim cmd As String
    cmd = "powershell -command ""[Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType = WindowsRuntime] > $null; " & _
          "$template = [Windows.UI.Notifications.ToastTemplateType]::ToastText01; " & _
          "$xml = [Windows.UI.Notifications.ToastNotificationManager]::GetTemplateContent($template); " & _
          "$text = $xml.GetElementsByTagName('text'); $text.Item(0).AppendChild($xml.CreateTextNode('" & msg & "')) > $null; " & _
          "$toast = [Windows.UI.Notifications.ToastNotification]::new($xml); " & _
          "$notifier = [Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier('Excel Reminder'); " & _
          "$notifier.Show($toast);"""

    Shell cmd, vbHide

End Sub


