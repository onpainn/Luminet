Option Explicit

Dim RemindersShown As Object

' =========================
' DAY NAME
' =========================
Function GetWeekDayName(d As Date) As String
    Select Case Weekday(d, vbMonday)
        Case 1: GetWeekDayName = "понедельник"
        Case 2: GetWeekDayName = "вторник"
        Case 3: GetWeekDayName = "среда"
        Case 4: GetWeekDayName = "четверг"
        Case 5: GetWeekDayName = "пятница"
        Case 6: GetWeekDayName = "суббота"
        Case 7: GetWeekDayName = "воскресенье"
    End Select
End Function

' =========================
' MAIN LOOP
' =========================
Sub CheckReminders()

    Dim ws As Worksheet
    Set ws = ThisWorkbook.Sheets("Лист1")

    If RemindersShown Is Nothing Then
        Set RemindersShown = CreateObject("Scripting.Dictionary")
    End If

    Dim i As Long, lastRow As Long
    lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row

    Dim currentDate As Date
    currentDate = Date

    Dim currentDateStr As String
    currentDateStr = Format(currentDate, "dd.mm.yyyy")

    Dim currentTime As String
    currentTime = Format(Time, "HH:MM")

    Dim currentWeekDay As String
    currentWeekDay = GetWeekDayName(currentDate)

    For i = 2 To lastRow

        ' =========================
        ' SKIP EMPTY ROWS
        ' =========================
        If Trim(ws.Cells(i, "A").Value) = "" And _
           Trim(ws.Cells(i, "K").Value) = "" And _
           Trim(ws.Cells(i, "L").Value) = "" Then
            GoTo NextRow
        End If

        Dim ruleDate As String, ruleTime As String
        ruleDate = LCase(Trim(ws.Cells(i, "K").Value))
        ruleTime = Trim(ws.Cells(i, "L").Value)

        ' =========================
        ' EVERY DAY
        ' =========================
        If InStr(ruleDate, "каждый день") > 0 Then
            Call CheckTime(ruleTime, currentTime, ws, i, currentDateStr)
        End If

        ' =========================
        ' WEEKLY
        ' =========================
        If InStr(ruleDate, "каждую неделю") > 0 Then

            Dim daysPart As String
            daysPart = Replace(ruleDate, "каждую неделю", "")

            Dim arrDays() As String
            arrDays = Split(daysPart, ",")

            Dim d As Variant
            For Each d In arrDays
                If Trim(d) = currentWeekDay Then
                    Call CheckTime(ruleTime, currentTime, ws, i, currentDateStr)
                    Exit For
                End If
            Next d

        End If

        ' =========================
        ' MONTHLY
        ' =========================
        If InStr(ruleDate, "каждый месяц") > 0 Then

            Dim monthDay As String
            monthDay = Trim(Replace(ruleDate, "каждый месяц", ""))

            If IsNumeric(monthDay) Then
                If Day(currentDate) = CInt(monthDay) Then
                    Call CheckTime(ruleTime, currentTime, ws, i, currentDateStr)
                End If
            End If

        End If

        ' =========================
        ' DATE LIST
        ' =========================
        Dim arrDate() As String
        Dim arrTime() As String

        If ruleDate <> "" Then arrDate = Split(ruleDate, ",")
        If ruleTime <> "" Then arrTime = Split(ruleTime, ",")

        Dim idx As Long

        If ruleDate <> "" Then

            For idx = 0 To UBound(arrDate)

                If Trim(arrDate(idx)) = currentDateStr Then

                    If UBound(arrTime) = 0 Then
                        Call CheckTime(ruleTime, currentTime, ws, i, currentDateStr)
                        Exit For
                    Else
                        If idx <= UBound(arrTime) Then
                            If Trim(arrTime(idx)) = currentTime Then
                                Call CheckTime(ruleTime, currentTime, ws, i, currentDateStr)
                            End If
                        End If
                    End If

                End If

            Next idx

        End If

NextRow:
    Next i

End Sub

' =========================
' TIME CHECK + MUTE COLUMN
' =========================
Sub CheckTime(ruleTime As String, currentTime As String, ws As Worksheet, rowIndex As Long, currentDateStr As String)

    ' COLUMN M = MUTE
    If Trim(ws.Cells(rowIndex, "M").Value) = "+" Then Exit Sub

    Dim arrTime() As String
    arrTime = Split(ruleTime, ",")

    Dim t As Variant

    For Each t In arrTime

        If Trim(t) = currentTime Then

            Dim key As String
            key = ws.Cells(rowIndex, "A").Value & "_" & currentDateStr & "_" & currentTime

            If Not RemindersShown.Exists(key) Then

                RemindersShown.Add key, True

                MsgBox "⏰ Напоминание!" & vbCrLf & _
                       "Задача: " & ws.Cells(rowIndex, "D").Value & vbCrLf & _
                       "Номер: " & ws.Cells(rowIndex, "A").Value

            End If

        End If

    Next t

End Sub