Sub ПоказатьДанныеБыстро()
    Dim wsBase As Worksheet, wsEdit As Worksheet
    Dim baseArr As Variant, editArr As Variant
    Dim dict As Object
    Dim lastRowBase As Long, lastRowEdit As Long
    Dim i As Long, j As Long
    Dim ID As Variant
    
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    
    Set wsBase = ThisWorkbook.Sheets(1)
    Set wsEdit = ThisWorkbook.Sheets(3)
    
    ' Найдем последнюю строку
    lastRowBase = wsBase.Cells(wsBase.Rows.Count, 4).End(xlUp).Row
    lastRowEdit = wsEdit.Cells(wsEdit.Rows.Count, 4).End(xlUp).Row
    
    ' Считываем всю базу в массив
    baseArr = wsBase.Range(wsBase.Cells(1, 1), wsBase.Cells(lastRowBase, 27)).Value
    
    ' Создаем словарь ID -> строка
    Set dict = CreateObject("Scripting.Dictionary")
    For i = 1 To UBound(baseArr, 1)
        dict(baseArr(i, 4)) = i ' ID в колонке 4
    Next i
    
    ' Считываем ID с листа редактирования (с 10 строки)
    For i = 10 To lastRowEdit
        ID = wsEdit.Cells(i, 4).Value
        If dict.exists(ID) Then
            ' Копируем всю строку из массива в лист редактирования
            For j = 1 To 27
                wsEdit.Cells(i, j).Value = baseArr(dict(ID), j)
            Next j
        ElseIf ID <> "" Then
            wsEdit.Cells(i, 1).Value = "ID не найден"
        End If
    Next i
    
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    
    MsgBox "Данные загружены быстро!"
End Sub






Sub СохранитьДанныеБыстро()
    Dim wsBase As Worksheet, wsEdit As Worksheet
    Dim baseArr As Variant
    Dim lastRowBase As Long, lastRowEdit As Long
    Dim dict As Object
    Dim i As Long, j As Long
    Dim ID As Variant
    
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    
    Set wsBase = ThisWorkbook.Sheets(1)
    Set wsEdit = ThisWorkbook.Sheets(3)
    
    lastRowBase = wsBase.Cells(wsBase.Rows.Count, 4).End(xlUp).Row
    lastRowEdit = wsEdit.Cells(wsEdit.Rows.Count, 4).End(xlUp).Row
    
    ' Считываем базу в массив
    baseArr = wsBase.Range(wsBase.Cells(1, 1), wsBase.Cells(lastRowBase, 27)).Value
    
    ' Создаем словарь ID -> строка
    Set dict = CreateObject("Scripting.Dictionary")
    For i = 1 To UBound(baseArr, 1)
        dict(baseArr(i, 4)) = i
    Next i
    
    ' Обновляем массив по ID
    For i = 10 To lastRowEdit
        ID = wsEdit.Cells(i, 4).Value
        If dict.exists(ID) Then
            For j = 1 To 27
                baseArr(dict(ID), j) = wsEdit.Cells(i, j).Value
            Next j
        End If
    Next i
    
    ' Сохраняем обратно на лист
    wsBase.Range(wsBase.Cells(1, 1), wsBase.Cells(lastRowBase, 27)).Value = baseArr
    
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    
    MsgBox "Данные успешно сохранены быстро!"
End Sub




Sub ДобавитьПользователей()
    Dim wsBase As Worksheet, wsEdit As Worksheet
    Dim lastRowBase As Long, lastRowEdit As Long
    Dim i As Long, j As Long
    Dim ID As Variant
    Dim newRow As Long
    
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    
    Set wsBase = ThisWorkbook.Sheets(1)
    Set wsEdit = ThisWorkbook.Sheets(3)
    
    ' Последние строки
    lastRowBase = wsBase.Cells(wsBase.Rows.Count, 4).End(xlUp).Row
    lastRowEdit = wsEdit.Cells(wsEdit.Rows.Count, 4).End(xlUp).Row
    
    newRow = lastRowBase + 1
    
    ' Проходим по новым данным
    For i = 10 To lastRowEdit
        ID = wsEdit.Cells(i, 4).Value
        
        If ID <> "" Then
            ' Просто добавляем строку
            For j = 1 To 27
                wsBase.Cells(newRow, j).Value = wsEdit.Cells(i, j).Value
            Next j
            
            newRow = newRow + 1
        End If
    Next i
    
    ' Очистка формы
    wsEdit.Rows("10:" & wsEdit.Rows.Count).ClearContents
    
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    
    MsgBox "Новые сотрудники добавлены!"
End Sub
