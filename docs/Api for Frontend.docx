Sub FullAuto_Copy_WithComments_NewLine()

    Dim sourceWB As Workbook, targetWB As Workbook
    Dim sourceWS As Worksheet, targetWS As Worksheet
    
    Dim sourceRange As Range
    Dim lastRow As Long, lastCol As Long
    Dim targetStartRow As Long
    Dim commentCol As Long
    
    Dim r As Long, c As Long
    Dim txt As String
    
    ' === ВЫБОР СТАРОГО ФАЙЛА ===
    With Application.FileDialog(msoFileDialogFilePicker)
        .Title = "Выбери СТАРЫЙ файл"
        If .Show <> -1 Then Exit Sub
        Set sourceWB = Workbooks.Open(.SelectedItems(1))
    End With
    
    Set sourceWS = sourceWB.Sheets(1)
    
    ' === АВТО-ОПРЕДЕЛЕНИЕ ТАБЛИЦЫ ===
    lastRow = sourceWS.Cells(Rows.Count, 1).End(xlUp).Row
    lastCol = sourceWS.Cells(1, Columns.Count).End(xlToLeft).Column
    
    Set sourceRange = sourceWS.Range(sourceWS.Cells(2, 1), sourceWS.Cells(lastRow, lastCol))
    
    ' === ВЫБОР НОВОГО ФАЙЛА ===
    With Application.FileDialog(msoFileDialogFilePicker)
        .Title = "Выбери НОВЫЙ файл (с шапкой)"
        If .Show <> -1 Then Exit Sub
        Set targetWB = Workbooks.Open(.SelectedItems(1))
    End With
    
    Set targetWS = targetWB.Sheets(1)
    
    ' === НАХОДИМ ПЕРВУЮ ПУСТУЮ СТРОКУ ===
    targetStartRow = targetWS.Cells(Rows.Count, 1).End(xlUp).Row + 1
    
    ' === ИЩЕМ КОЛОНКУ "Комментарии" ===
    commentCol = 0
    
    For c = 1 To targetWS.Cells(1, Columns.Count).End(xlToLeft).Column
        If LCase(targetWS.Cells(1, c).Value) Like "*коммент*" Then
            commentCol = c
            Exit For
        End If
    Next c
    
    ' если нет — создаём
    If commentCol = 0 Then
        commentCol = targetWS.Cells(1, Columns.Count).End(xlToLeft).Column + 1
        targetWS.Cells(1, commentCol).Value = "Комментарии"
    End If
    
    ' === КОПИРУЕМ ДАННЫЕ ===
    sourceRange.Copy
    targetWS.Cells(targetStartRow, 1).PasteSpecial xlPasteValues
    
    ' === СОБИРАЕМ КОММЕНТАРИИ ===
    For r = 1 To sourceRange.Rows.Count
        
        txt = ""
        
        For c = 1 To sourceRange.Columns.Count
            
            ' старые заметки
            If Not sourceRange.Cells(r, c).Comment Is Nothing Then
                txt = txt & sourceRange.Cells(r, c).Comment.Text & vbNewLine
            End If
            
            ' новые комментарии
            On Error Resume Next
            If sourceRange.Cells(r, c).CommentThreaded.Count > 0 Then
                Dim cmt As CommentThreaded
                For Each cmt In sourceRange.Cells(r, c).CommentThreaded
                    txt = txt & cmt.Text & vbNewLine
                Next cmt
            End If
            On Error GoTo 0
            
        Next c
        
        ' записываем
        If txt <> "" Then
            targetWS.Cells(targetStartRow + r - 1, commentCol).Value = txt
            targetWS.Cells(targetStartRow + r - 1, commentCol).WrapText = True
        End If
        
    Next r
    
    MsgBox "Готово! 🚀"

End Sub