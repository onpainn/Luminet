Dim dictAll As Object
Set dictAll = CreateObject("Scripting.Dictionary")

Dim key

' собираем все статусы
For Each key In dictIn.keys
    If Not dictAll.exists(key) Then dictAll.Add key, 1
Next key

For Each key In dictOut.keys
    If Not dictAll.exists(key) Then dictAll.Add key, 1
Next key


' ===== заголовки =====
statRow = 2
col = 2

For Each key In dictAll.keys
    wsLog.Cells(statRow, col) = key
    col = col + 1
Next key


' ===== пришло =====
wsLog.Cells(statRow + 1, 1) = "Пришло"

col = 2
For Each key In dictAll.keys

    If dictIn.exists(key) Then
        wsLog.Cells(statRow + 1, col) = dictIn(key)
    Else
        wsLog.Cells(statRow + 1, col) = 0
    End If

    col = col + 1

Next key


' ===== ушло =====
wsLog.Cells(statRow + 2, 1) = "Ушло"

col = 2
For Each key In dictAll.keys

    If dictOut.exists(key) Then
        wsLog.Cells(statRow + 2, col) = dictOut(key)
    Else
        wsLog.Cells(statRow + 2, col) = 0
    End If

    col = col + 1

Next key