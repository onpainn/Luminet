Function ExtractStartDate(txt As Variant) As String

    Dim words() As String
    Dim i As Long, w As String
    
    If IsError(txt) Or IsEmpty(txt) Then Exit Function
    
    txt = LCase(CStr(txt))
    
    ' заменяем все разделители на пробел
    txt = Replace(txt, ".", " ")
    txt = Replace(txt, ",", " ")
    txt = Replace(txt, ";", " ")
    txt = Replace(txt, ":", " ")
    
    words = Split(txt, " ")
    
    Dim months As Object
    Set months = CreateObject("Scripting.Dictionary")
    
    months.Add "января", 1
    months.Add "февраля", 2
    months.Add "марта", 3
    months.Add "апреля", 4
    months.Add "мая", 5
    months.Add "июня", 6
    months.Add "июля", 7
    months.Add "августа", 8
    months.Add "сентября", 9
    months.Add "октября", 10
    months.Add "ноября", 11
    months.Add "декабря", 12
    
    ' ищем первую дату в первых 10 словах
    For i = LBound(words) To Application.WorksheetFunction.Min(UBound(words), 9)
        
        w = CleanWord(words(i))
        
        ' ===== цифровая дата =====
        If w Like "## ## ####" Then
            ExtractStartDate = Format(DateSerial(words(i + 2), words(i + 1), words(i)), "dd.mm.yyyy")
            Exit Function
        End If
        
        ' ===== текстовый месяц =====
        If i + 2 <= UBound(words) Then
            If IsNumeric(w) And months.exists(CleanWord(words(i + 1))) And IsNumeric(CleanWord(words(i + 2))) Then
                ExtractStartDate = Format(DateSerial(words(i + 2), months(CleanWord(words(i + 1))), w), "dd.mm.yyyy")
                Exit Function
            End If
        End If
        
    Next i

End Function

Function ExtractEndDate(txt As Variant) As String

    Dim words() As String
    Dim i As Long, w As String
    
    If IsError(txt) Or IsEmpty(txt) Then Exit Function
    
    txt = LCase(CStr(txt))
    
    ' заменяем разделители на пробел
    txt = Replace(txt, ".", " ")
    txt = Replace(txt, ",", " ")
    txt = Replace(txt, ";", " ")
    txt = Replace(txt, ":", " ")
    
    words = Split(txt, " ")
    
    Dim months As Object
    Set months = CreateObject("Scripting.Dictionary")
    
    months.Add "января", 1
    months.Add "февраля", 2
    months.Add "марта", 3
    months.Add "апреля", 4
    months.Add "мая", 5
    months.Add "июня", 6
    months.Add "июля", 7
    months.Add "августа", 8
    months.Add "сентября", 9
    months.Add "октября", 10
    months.Add "ноября", 11
    months.Add "декабря", 12
    
    ' ищем слово "по" — обычно перед датой конца
    Dim posPo As Long
    posPo = InStr(txt, "по")
    If posPo = 0 Then Exit Function
    
    Dim subText As String
    subText = Trim(Mid(txt, posPo + 2))
    
    words = Split(subText, " ")
    
    ' ищем первую дату в первых 6 словах после "по"
    For i = LBound(words) To Application.WorksheetFunction.Min(UBound(words), 5)
        
        w = CleanWord(words(i))
        
        ' ===== цифровая дата =====
        If w Like "## ## ####" Then
            ExtractEndDate = Format(DateSerial(words(i + 2), words(i + 1), words(i)), "dd.mm.yyyy")
            Exit Function
        End If
        
        ' ===== текстовый месяц =====
        If i + 2 <= UBound(words) Then
            If IsNumeric(w) And months.exists(CleanWord(words(i + 1))) And IsNumeric(CleanWord(words(i + 2))) Then
                ExtractEndDate = Format(DateSerial(words(i + 2), months(CleanWord(words(i + 1))), w), "dd.mm.yyyy")
                Exit Function
            End If
        End If
        
    Next i

End Function

Function CleanWord(w As String) As String
    w = Replace(w, ".", "")
    w = Replace(w, ",", "")
    w = Replace(w, ";", "")
    w = Replace(w, ":", "")
    w = Replace(w, "(", "")
    w = Replace(w, ")", "")
    w = Trim(w)
    CleanWord = w
End Function