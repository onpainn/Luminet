'=============================
' Маппинг статусов → конкретные ячейки
'=============================
Dim mapCells As Object
Set mapCells = CreateObject("Scripting.Dictionary")

' Пример: статус → ячейка
mapCells.Add "в наличии", "B2"
mapCells.Add "не в сети", "C2"
mapCells.Add "ремонт", "D2"
mapCells.Add "отсутствует", "E2"
' Добавляй свои статусы сюда

'=============================
' Находим строку для вставки (например после существующих данных)
'=============================
Dim statRow As Long
statRow = wsLog.Cells(wsLog.Rows.Count, 1).End(xlUp).Row + 2

' Подпись
wsLog.Cells(statRow, 1) = "Изменения"

'=============================
' Заполняем значения ПРИШЛО/УШЛО
'=============================
Dim key As Variant
Dim inVal As Long, outVal As Long

For Each key In mapCells.Keys

    ' --- пришло ---
    If dictIn.exists(key) Then
        inVal = dictIn(key)
    Else
        inVal = 0
    End If

    ' --- ушло ---
    If dictOut.exists(key) Then
        outVal = dictOut(key)
    Else
        outVal = 0
    End If

    ' --- записываем в нужную ячейку ---
    wsLog.Range(mapCells(key)).Value = inVal & "/" & outVal

Next key