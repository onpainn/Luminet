Sub ExportRangeFromChosenFile()

    Dim wbData As Workbook
    Dim ws As Worksheet
    Dim rng As Range
    
    Dim filePath As String
    
    ' =========================
    ' ВЫБОР ФАЙЛА EXCEL
    ' =========================
    With Application.FileDialog(msoFileDialogFilePicker)
        .Title = "Выбери файл с данными"
        .Filters.Clear
        .Filters.Add "Excel файлы", "*.xlsx; *.xlsm"
        
        If .Show = -1 Then
            filePath = .SelectedItems(1)
        Else
            MsgBox "Файл не выбран!"
            Exit Sub
        End If
    End With
    
    ' Открываем выбранный файл
    Set wbData = Workbooks.Open(filePath)
    Set ws = wbData.Sheets(1)
    
    ' =========================
    ' ДИАПАЗОН
    ' =========================
    
    ' ⚠️ УКАЖИ СВОЙ ДИАПАЗОН
    Set rng = ws.Range("A2:E5")
    
    ' =========================
    ' WORD
    ' =========================
    
    Dim wdApp As Object
    Dim wdDoc As Object
    Dim wdTable As Object
    
    Set wdApp = CreateObject("Word.Application")
    wdApp.Visible = True
    
    ' ⚠️ ПУТЬ К ШАБЛОНУ
    Dim templatePath As String
    templatePath = "C:\Data\template\template.docx"
    
    Set wdDoc = wdApp.Documents.Open(templatePath)
    
    ' Первая таблица в Word
    Set wdTable = wdDoc.Tables(1)
    
    ' =========================
    ' ПЕРЕНОС ДАННЫХ
    ' =========================
    
    Dim i As Long, j As Long
    
    For i = 1 To rng.Rows.Count
        For j = 1 To rng.Columns.Count
            
            ' ⚠️ если есть заголовки в Word
            wdTable.Cell(i + 1, j + 1).Range.Text = rng.Cells(i, j).Value
            
        Next j
    Next i
    
    ' =========================
    ' СОХРАНЕНИЕ
    ' =========================
    
    Dim resultFolder As String
    Dim savePath As String
    
    resultFolder = "C:\Data\result\"
    
    If Dir(resultFolder, vbDirectory) = "" Then
        MkDir resultFolder
    End If
    
    savePath = resultFolder & "TableReport_" & Format(Date, "dd-mm-yyyy") & ".docx"
    
    wdDoc.SaveAs2 savePath
    
    ' Закрываем файл базы
    wbData.Close False
    
    MsgBox "Готово: " & savePath

End Sub