Function ExtractStartDate(txt As Variant) As String

    Dim words() As String
    Dim i As Long, w As String
    Dim dayVal As Long, monthVal As Long, yearVal As Long
    
    If IsError(txt) Or IsEmpty(txt) Then Exit Function
    
    txt = LCase(CStr(txt))
    
    ' заменяем только лишние разделители, чтобы разбить на слова
    Dim tmp As String
    tmp = Replace(txt, ",", " ")
    tmp = Replace(tmp, ";", " ")
    tmp = Replace(tmp, ":", " ")
    
    words = Split(tmp, " ")
    
    Dim months As Object
    Set months = CreateObject("Scripting.Dictionary")
    months.Add "января", 1
    months.Add "февраля", 2
    months.Add "марта", 3
    months.Add "апреля", 4
    months.Add "мая", 5
    months.Add "июня", 6
    months.Add "июля", 7
    months.Add "августа", 8
    months.Add "сентября", 9
    months.Add "октября", 10
    months.Add "ноября", 11
    months.Add "декабря", 12
    
    ' ищем первую дату в первых 10 словах
    For i = LBound(words) To Application.WorksheetFunction.Min(UBound(words), 9)
        
        w = CleanWord(words(i))
        
        ' ===== цифровая дата =====
        If w Like "##.##.####" Then
            ExtractStartDate = w  ' оставляем точки как в исходном тексте
            Exit Function
        End If
        
        ' ===== текстовый месяц =====
        If i + 2 <= UBound(words) Then
            Dim w1 As String, w2 As String
            w1 = CleanWord(words(i + 1))
            w2 = CleanWord(words(i + 2))
            
            If IsNumeric(w) And months.exists(w1) And IsNumeric(w2) Then
                dayVal = CLng(w)
                monthVal = months(w1)
                yearVal = CLng(w2)
                
                ExtractStartDate = Format(DateSerial(yearVal, monthVal, dayVal), "dd.mm.yyyy")
                Exit Function
            End If
        End If
        
    Next i

End Function
Function ExtractEndDate(txt As Variant) As String

    Dim words() As String
    Dim i As Long, w As String
    Dim dayVal As Long, monthVal As Long, yearVal As Long
    
    If IsError(txt) Or IsEmpty(txt) Then Exit Function
    
    txt = LCase(CStr(txt))
    
    ' ищем слово "по" — обычно перед датой конца диапазона
    Dim posPo As Long
    posPo = InStr(txt, "по")
    If posPo = 0 Then Exit Function
    
    Dim subText As String
    subText = Trim(Mid(txt, posPo + 2))
    
    ' заменяем только разделители
    subText = Replace(subText, ",", " ")
    subText = Replace(subText, ";", " ")
    subText = Replace(subText, ":", " ")
    
    words = Split(subText, " ")
    
    Dim months As Object
    Set months = CreateObject("Scripting.Dictionary")
    months.Add "января", 1
    months.Add "февраля", 2
    months.Add "марта", 3
    months.Add "апреля", 4
    months.Add "мая", 5
    months.Add "июня", 6
    months.Add "июля", 7
    months.Add "августа", 8
    months.Add "сентября", 9
    months.Add "октября", 10
    months.Add "ноября", 11
    months.Add "декабря", 12
    
    ' ищем первую дату в первых 6 словах после "по"
    For i = LBound(words) To Application.WorksheetFunction.Min(UBound(words), 5)
        
        w = CleanWord(words(i))
        
        ' ===== цифровая дата =====
        If w Like "##.##.####" Then
            ExtractEndDate = w  ' точки сохраняем
            Exit Function
        End If
        
        ' ===== текстовый месяц =====
        If i + 2 <= UBound(words) Then
            Dim w1 As String, w2 As String
            w1 = CleanWord(words(i + 1))
            w2 = CleanWord(words(i + 2))
            
            If IsNumeric(w) And months.exists(w1) And IsNumeric(w2) Then
                dayVal = CLng(w)
                monthVal = months(w1)
                yearVal = CLng(w2)
                
                ExtractEndDate = Format(DateSerial(yearVal, monthVal, dayVal), "dd.mm.yyyy")
                Exit Function
            End If
        End If
        
    Next i

End Function
Function CleanWord(w As String) As String
    w = Replace(w, ",", "")
    w = Replace(w, ";", "")
    w = Replace(w, ":", "")
    w = Replace(w, "(", "")
    w = Replace(w, ")", "")
    CleanWord = Trim(w)
End Function