Sub ExportByStatus_ULTRA_FAST()

    Dim wbSource As Workbook
    Dim wsSource As Worksheet
    
    Dim wbNew As Workbook
    Dim wsNew As Worksheet
    
    Dim fd As FileDialog
    Dim statusFilter As String
    
    Dim data As Variant
    Dim result() As Variant
    
    Dim i As Long, j As Long
    Dim lastRow As Long
    Dim colCount As Long
    Dim resultRow As Long
    
    ' =========================
    ' УСКОРЕНИЕ
    ' =========================
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    Application.EnableEvents = False
    
    ' =========================
    ' СТАТУС
    ' =========================
    statusFilter = Replace(Replace(UCase(Trim(ThisWorkbook.Sheets(1).Range("A1").Value)), Chr(160), ""), """", "")
    
    If statusFilter = "" Then
        MsgBox "Выбери статус"
        GoTo ExitHandler
    End If
    
    ' =========================
    ' ВЫБОР ФАЙЛА
    ' =========================
    Set fd = Application.FileDialog(msoFileDialogFilePicker)
    If fd.Show <> -1 Then GoTo ExitHandler
    
    Set wbSource = Workbooks.Open(fd.SelectedItems(1))
    Set wsSource = wbSource.Sheets(1)
    
    ' =========================
    ' ЗАГРУЗКА В МАССИВ
    ' =========================
    lastRow = wsSource.Cells(wsSource.Rows.Count, 1).End(xlUp).Row
    colCount = 5 ' сколько колонок берем
    
    data = wsSource.Range("A2:E" & lastRow).Value
    
    ' =========================
    ' СОЗДАЕМ МАССИВ РЕЗУЛЬТАТА
    ' =========================
    ReDim result(1 To UBound(data, 1), 1 To colCount)
    
    resultRow = 0
    
    ' =========================
    ' ФИЛЬТРАЦИЯ В ПАМЯТИ
    ' =========================
    For i = 1 To UBound(data, 1)
        
        Dim status As String
        
        status = Replace(Replace(UCase(Trim(data(i, 4))), Chr(160), ""), """", "")
        
        If status = statusFilter Then
            
            resultRow = resultRow + 1
            
            For j = 1 To colCount
                result(resultRow, j) = data(i, j)
            Next j
            
        End If
        
    Next i
    
    ' =========================
    ' НОВЫЙ ФАЙЛ
    ' =========================
    Set wbNew = Workbooks.Add
    Set wsNew = wbNew.Sheets(1)
    
    ' ШАПКА
    wsNew.Range("A1:E1").Value = Array("ID", "Название", "Категория", "Статус", "Город")
    
    ' =========================
    ' ВЫГРУЗКА В EXCEL
    ' =========================
    If resultRow > 0 Then
        wsNew.Range("A2").Resize(resultRow, colCount).Value = result
    End If
    
    ' =========================
    ' СОРТИРОВКА
    ' =========================
    Dim lastNewRow As Long
    lastNewRow = wsNew.Cells(wsNew.Rows.Count, 1).End(xlUp).Row
    
    If lastNewRow > 1 Then
        With wsNew.Sort
            .SortFields.Clear
            .SortFields.Add Key:=wsNew.Range("B2:B" & lastNewRow), Order:=xlAscending
            .SetRange wsNew.Range("A1:E" & lastNewRow)
            .Header = xlYes
            .Apply
        End With
    End If
    
    ' =========================
    ' ОФОРМЛЕНИЕ
    ' =========================
    With wsNew.Range("A1:E" & lastNewRow)
        .HorizontalAlignment = xlCenter
        .VerticalAlignment = xlCenter
        .Borders.LineStyle = xlContinuous
    End With
    
    wsNew.Range("A1:E1").Font.Bold = True
    wsNew.Columns("A:E").AutoFit
    
    ' =========================
    ' СОХРАНЕНИЕ
    ' =========================
    Dim folderPath As String
    Dim savePath As String
    
    folderPath = ThisWorkbook.Path & "\result\"
    If Dir(folderPath, vbDirectory) = "" Then MkDir folderPath
    
    savePath = folderPath & "Report_" & statusFilter & "_" & Format(Date, "dd-mm-yyyy") & ".xlsx"
    
    wbNew.SaveAs savePath
    
    wbSource.Close False
    
    MsgBox "Готово: " & savePath

ExitHandler:
    
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    Application.EnableEvents = True

End Sub