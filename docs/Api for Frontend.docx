If LCase(status) = "работает" Then
    
    Dim city As String
    Dim cityKey As String
    
    city = LCase(Trim(wsData.Cells(i, 1).Value))
    
    ' Москва или регионы
    Select Case city
        Case "москва", "химки", "мытищи", "люберцы"
            cityKey = dept & " Москва"
        Case Else
            cityKey = dept & " Регионы"
    End Select
    
    ' Словарь
    If Not dict.exists(cityKey) Then
        dict.Add cityKey, CreateObject("Scripting.Dictionary")
        dict(cityKey).Add "Target", 0
        dict(cityKey).Add "Intern", 0
    End If
    
    dict(cityKey)(catGroup) = dict(cityKey)(catGroup) + 1
    
End If