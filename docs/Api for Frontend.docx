If dictOld.exists(id) Then

    oldStatus = Trim(LCase(dictOld(id)))
    newStatus = Trim(LCase(status))

    If oldStatus <> newStatus Then

        ' ===== запись изменения товара =====
        logRow = logRow + 1
        
        wsLog.Cells(logRow, 1) = name
        wsLog.Cells(logRow, 2) = id
        wsLog.Cells(logRow, 3) = oldStatus
        wsLog.Cells(logRow, 4) = newStatus

        ' ===== считаем ушло =====
        If dictOut.exists(oldStatus) Then
            dictOut(oldStatus) = dictOut(oldStatus) + 1
        Else
            dictOut.Add oldStatus, 1
        End If

        ' ===== считаем пришло =====
        If dictIn.exists(newStatus) Then
            dictIn(newStatus) = dictIn(newStatus) + 1
        Else
            dictIn.Add newStatus, 1
        End If

    End If

End If