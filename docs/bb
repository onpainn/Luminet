Sub LoadTodayData()

    Dim ws1 As Worksheet, ws2 As Worksheet
    Dim lastRow As Long, i As Long
    Dim pasteRow As Long
    
    Set ws1 = ThisWorkbook.Sheets("Лист1")
    Set ws2 = ThisWorkbook.Sheets("Лист2")
    
    ws2.Cells.Clear
    pasteRow = 1
    
    lastRow = ws1.Cells(ws1.Rows.Count, "I").End(xlUp).Row
    
    For i = 1 To lastRow
        If ws1.Cells(i, "I").Value = Date Then
            ws1.Range(ws1.Cells(i, "A"), ws1.Cells(i, "O")).Copy _
                ws2.Cells(pasteRow, "A")
            pasteRow = pasteRow + 1
        End If
    Next i

    MsgBox "Данные загружены!"

End Sub


Sub SaveBackData()

    Dim ws1 As Worksheet, ws2 As Worksheet
    Dim lastRow1 As Long, lastRow2 As Long
    Dim i As Long, j As Long
    
    Set ws1 = ThisWorkbook.Sheets("Лист1")
    Set ws2 = ThisWorkbook.Sheets("Лист2")
    
    lastRow1 = ws1.Cells(ws1.Rows.Count, "A").End(xlUp).Row
    lastRow2 = ws2.Cells(ws2.Rows.Count, "A").End(xlUp).Row
    
    For i = 1 To lastRow2
        For j = 1 To lastRow1
            
            ' Сравниваем ID (колонка A)
            If ws2.Cells(i, "A").Value = ws1.Cells(j, "A").Value Then
                
                ws2.Range(ws2.Cells(i, "A"), ws2.Cells(i, "O")).Copy _
                    ws1.Cells(j, "A")
                    
                Exit For
            End If
            
        Next j
    Next i

    MsgBox "Изменения сохранены!"

End Sub



Sub LoadByDateFull()

    Dim ws1 As Worksheet, ws2 As Worksheet
    Dim lastRow As Long, i As Long
    Dim pasteRow As Long
    Dim userDate As Date
    
    Set ws1 = ThisWorkbook.Sheets("Лист1")
    Set ws2 = ThisWorkbook.Sheets("Лист2")
    
    ' Проверка даты
    If Not IsDate(ws2.Range("B1").Value) Then
        MsgBox "Введите корректную дату в ячейку B1!", vbExclamation
        Exit Sub
    End If
    
    userDate = ws2.Range("B1").Value
    
    ' Очистка старых данных (оставляем строку с датой)
    ws2.Range("A2:P100000").ClearContents
    pasteRow = 2
    
    ' Последняя строка
    lastRow = ws1.Cells(ws1.Rows.Count, "I").End(xlUp).Row
    
    ' Перебор
    For i = 1 To lastRow
        
        If Not IsError(ws1.Cells(i, "I").Value) Then
            
            If IsDate(ws1.Cells(i, "I").Value) Then
                
                If Int(ws1.Cells(i, "I").Value) = Int(userDate) Then
                    
                    ws2.Range(ws2.Cells(pasteRow, "A"), ws2.Cells(pasteRow, "P")).Value = _
                    ws1.Range(ws1.Cells(i, "A"), ws1.Cells(i, "P")).Value
                    
                    pasteRow = pasteRow + 1
                    
                End If
                
            End If
            
        End If
        
    Next i

    MsgBox "Данные загружены 👍"

End Sub

