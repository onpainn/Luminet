Option Explicit

Dim dict As Object
Dim wdApp As Object

Sub RunSearch()

    Dim wbEmp As Workbook, wsEmp As Worksheet
    Dim wbRes As Workbook, wsRes As Worksheet
    
    Dim lastRow As Long, i As Long
    Dim fio As String, category As String, id As String
    Dim arr() As String
    Dim lastName As String, firstName As String, patronymic As String
    
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    
    Set dict = CreateObject("Scripting.Dictionary")
    
    ' =========================
    ' 1. ЗАГРУЗКА БАЗЫ
    ' =========================
    
    Set wbEmp = Workbooks.Open("D:\employees.xlsx")
    Set wsEmp = wbEmp.Sheets(1)
    
    lastRow = wsEmp.Cells(wsEmp.Rows.Count, "C").End(xlUp).Row
    
    For i = 2 To lastRow
        
        category = LCase(Trim(wsEmp.Cells(i, "B").Value))
        
        If InStr(category, "рабоч") = 0 Then GoTo NextI
        
        fio = LCase(Trim(wsEmp.Cells(i, "C").Value))
        id = wsEmp.Cells(i, "E").Value
        
        If fio = "" Then GoTo NextI
        
        arr = Split(fio, " ")
        If UBound(arr) < 1 Then GoTo NextI
        
        lastName = arr(0)
        firstName = arr(1)
        
        If UBound(arr) >= 2 Then
            patronymic = arr(2)
        Else
            patronymic = ""
        End If
        
        ' ключ = фамилия (как основа)
        If Not dict.exists(lastName) Then
            dict.Add lastName, lastName & "|" & firstName & "|" & patronymic & "|" & fio & "|" & id
        End If

NextI:
    Next i
    
    wbEmp.Close False
    
    ' =========================
    ' 2. РЕЗУЛЬТАТ
    ' =========================
    
    Set wbRes = Workbooks.Open("D:\result.xlsx")
    Set wsRes = wbRes.Sheets(1)
    
    Dim resRow As Long
    resRow = wsRes.Cells(wsRes.Rows.Count, 1).End(xlUp).Row + 1
    
    ' =========================
    ' 3. WORD
    ' =========================
    
    Set wdApp = CreateObject("Word.Application")
    wdApp.Visible = False
    
    ProcessFolder "D:\Docs\", wsRes, resRow
    
    wdApp.Quit
    Set wdApp = Nothing
    
    wbRes.Save
    wbRes.Close
    
    Application.ScreenUpdating = True
    
    MsgBox "Готово!"

End Sub


' =========================
' ПАПКИ
' =========================
Sub ProcessFolder(path As String, ws As Worksheet, ByRef resRow As Long)

    Dim fso As Object
    Dim folder As Object, subfolder As Object, file As Object
    
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set folder = fso.GetFolder(path)
    
    For Each file In folder.Files
        If LCase(file.Name) Like "*.doc*" Then
            ProcessWordFile file.Path, file.Name, ws, resRow
        End If
    Next file
    
    For Each subfolder In folder.SubFolders
        ProcessFolder subfolder.Path, ws, resRow
    Next subfolder

End Sub


' =========================
' WORD ОБРАБОТКА
' =========================
Sub ProcessWordFile(filePath As String, fileName As String, ws As Worksheet, ByRef resRow As Long)

    Dim wdDoc As Object
    Dim docText As String
    Dim key As Variant
    Dim data As String
    Dim parts() As String
    
    Dim lastName As String, firstName As String, patronymic As String
    
    On Error Resume Next
    
    Set wdDoc = wdApp.Documents.Open(filePath, ReadOnly:=True, AddToRecentFiles:=False)
    If wdDoc Is Nothing Then Exit Sub
    
    docText = LCase(wdDoc.Content.Text)

    For Each key In dict.Keys
        
        ' 🔥 мягкое сравнение фамилии (учёт падежей)
        If InStr(docText, Left(key, Len(key) - 1)) > 0 Then
            
            data = dict(key)
            parts = Split(data, "|")
            
            If UBound(parts) < 4 Then GoTo NextKey
            
            lastName = parts(0)
            firstName = parts(1)
            patronymic = parts(2)
            
            ' =========================
            ' УМНАЯ ПРОВЕРКА
            ' =========================
            
            If InStr(docText, firstName) = 0 Then GoTo NextKey
            
            If patronymic <> "" Then
                If InStr(docText, patronymic) = 0 Then GoTo NextKey
            End If
            
            ' =========================
            ' ЗАПИСЬ
            ' =========================
            
            ws.Cells(resRow, 1).Value = parts(3) ' ФИО
            ws.Cells(resRow, 2).Value = parts(4) ' ID
            ws.Cells(resRow, 3).Value = docText
            ws.Cells(resRow, 4).Value = fileName
            
            resRow = resRow + 1
            
        End If

NextKey:
    Next key
    
    wdDoc.Close False
    Set wdDoc = Nothing

End Sub