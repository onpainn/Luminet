' =========================
Sub ProcessWordFile(filePath As String, fileName As String, ws As Worksheet, ByRef resRow As Long)

    Dim wdDoc As Object
    Dim sections() As String
    
    Dim key As Variant
    Dim data As String
    Dim parts() As String
    
    Dim i As Long
    Dim outputText As String
    Dim searchText As String
    
    On Error Resume Next
    
    Set wdDoc = wdApp.Documents.Open(filePath, ReadOnly:=True)
    If wdDoc Is Nothing Then Exit Sub

    ' =========================
    ' делим по §
    ' =========================
    sections = Split(wdDoc.Content.Text, "§")

    ' =========================
    ' поиск по ID
    ' =========================
    For Each key In dict.Keys
        
        data = dict(key)
        parts = Split(data, "|")
        
        For i = 0 To UBound(sections)
            
            outputText = sections(i)
            searchText = CleanID(outputText)
            
            If InStr(searchText, key) > 0 Then
                
                ws.Cells(resRow, 1).Value = parts(0)
                ws.Cells(resRow, 2).Value = FormatID(parts(1))
                ws.Cells(resRow, 3).Value = outputText
                ws.Cells(resRow, 4).Value = fileName
                
                ws.Cells(resRow, 3).WrapText = True
                
                resRow = resRow + 1
                
            End If
            
        Next i
        
    Next key

    wdDoc.Close False
    Set wdDoc = Nothing

End Sub


































