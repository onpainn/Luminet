' =========================
Sub ProcessWordFile(filePath As String, fileName As String, ws As Worksheet, ByRef resRow As Long)

    Dim wdDoc As Object
    Dim docText As String
    Dim key As Variant
    Dim data As String
    Dim parts() As String
    
    Dim cleanDoc As String
    
    On Error Resume Next
    
    Set wdDoc = wdApp.Documents.Open(filePath, ReadOnly:=True, AddToRecentFiles:=False)
    If wdDoc Is Nothing Then Exit Sub

    ' =========================
    ' ЧИСТИМ ТЕКСТ WORD
    ' =========================
    cleanDoc = CleanID(wdDoc.Content.Text)

    ' =========================
    ' ПОИСК ПО ID
    ' =========================
    For Each key In dict.Keys
        
        If InStr(cleanDoc, key) > 0 Then
            
            data = dict(key)
            parts = Split(data, "|")
            
            ws.Cells(resRow, 1).Value = parts(0) ' ФИО
            ws.Cells(resRow, 2).Value = parts(1) ' ID
            ws.Cells(resRow, 3).Value = wdDoc.Content.Text ' оригинальный текст
            ws.Cells(resRow, 4).Value = fileName
            
            resRow = resRow + 1
            
        End If
        
    Next key

    wdDoc.Close False
    Set wdDoc = Nothing

End Sub













