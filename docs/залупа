' =========================
' WORD ОБРАБОТКА
' =========================
Sub ProcessWordFile(filePath As String, fileName As String, ws As Worksheet, ByRef resRow As Long)

    Dim wdDoc As Object
    Dim docText As String
    Dim key As Variant
    Dim data As String
    Dim parts() As String
    
    Dim lastName As String, firstName As String, patronymic As String
    
    On Error Resume Next
    
    Set wdDoc = wdApp.Documents.Open(filePath, ReadOnly:=True, AddToRecentFiles:=False)
    If wdDoc Is Nothing Then Exit Sub
    
    docText = LCase(wdDoc.Content.Text)

    For Each key In dict.Keys
        
        ' 🔥 мягкое сравнение фамилии (учёт падежей)
        If InStr(docText, Left(key, Len(key) - 1)) > 0 Then
            
            data = dict(key)
            parts = Split(data, "|")
            
            If UBound(parts) < 4 Then GoTo NextKey
            
            lastName = parts(0)
            firstName = parts(1)
            patronymic = parts(2)
            
            ' =========================
            ' УМНАЯ ПРОВЕРКА
            ' =========================
            
            If InStr(docText, firstName) = 0 Then GoTo NextKey
            
            If patronymic <> "" Then
                If InStr(docText, patronymic) = 0 Then GoTo NextKey
            End If
            
            ' =========================
            ' ЗАПИСЬ
            ' =========================
            
            ws.Cells(resRow, 1).Value = parts(3) ' ФИО
            ws.Cells(resRow, 2).Value = parts(4) ' ID
            ws.Cells(resRow, 3).Value = docText
            ws.Cells(resRow, 4).Value = fileName
            
            resRow = resRow + 1
            
        End If

NextKey:
    Next key
    
    wdDoc.Close False
    Set wdDoc = Nothing

End Sub