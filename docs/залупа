Option Explicit

Dim dict As Object
Dim wdApp As Object

' =========================
' ЧИСТКА ID (для поиска)
' =========================
Function CleanID(txt As String) As String
    
    txt = LCase(txt)
    
    txt = Replace(txt, " ", "")
    txt = Replace(txt, Chr(160), "")
    txt = Replace(txt, vbTab, "")
    txt = Replace(txt, vbCr, "")
    txt = Replace(txt, vbLf, "")
    
    txt = Replace(txt, "-", "")
    txt = Replace(txt, "–", "")
    txt = Replace(txt, "—", "")
    
    CleanID = txt

End Function


' =========================
' ФОРМАТ ID ДЛЯ EXCEL
' =========================
Function FormatID(txt As String) As String
    
    Dim clean As String
    clean = CleanID(txt)
    
    Dim i As Long
    Dim letters As String
    Dim numbers As String
    Dim ch As String
    
    For i = 1 To Len(clean)
        
        ch = Mid(clean, i, 1)
        
        If (ch >= "A" And ch <= "Z") Or (ch >= "a" And ch <= "z") _
        Or (ch >= "А" And ch <= "Я") Or (ch >= "а" And ch <= "я") Then
            letters = letters & ch
        End If
        
        If ch >= "0" And ch <= "9" Then
            numbers = numbers & ch
        End If
        
    Next i
    
    If letters <> "" And numbers <> "" Then
        FormatID = UCase(letters) & "-" & numbers
    Else
        FormatID = UCase(clean)
    End If

End Function


