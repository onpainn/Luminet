Function FormatID(txt As String) As String
    
    Dim clean As String
    clean = CleanID(txt)
    
    ' если уже есть дефис — просто возвращаем
    If InStr(txt, "-") > 0 Then
        FormatID = UCase(txt)
        Exit Function
    End If
    
    ' ищем буквы и цифры
    Dim i As Long
    Dim letters As String, numbers As String
    
    For i = 1 To Len(clean)
        If Mid(clean, i, 1) Like "[A-Za-z]" Then
            letters = letters & Mid(clean, i, 1)
        ElseIf Mid(clean, i, 1) Like "[0-9]" Then
            numbers = numbers & Mid(clean, i, 1)
        End If
    Next i
    
    If letters <> "" And numbers <> "" Then
        FormatID = UCase(letters & "-" & numbers)
    Else
        FormatID = UCase(clean)
    End If

End Function












Sub ProcessWordFile(filePath As String, fileName As String, ws As Worksheet, ByRef resRow As Long)

    Dim wdDoc As Object
    Dim key As Variant
    Dim data As String
    Dim parts() As String
    
    Dim cleanDoc As String
    Dim sections() As String
    Dim i As Long
    Dim blockText As String
    
    On Error Resume Next
    
    Set wdDoc = wdApp.Documents.Open(filePath, ReadOnly:=True, AddToRecentFiles:=False)
    If wdDoc Is Nothing Then Exit Sub

    ' =========================
    ' ЧИСТЫЙ ТЕКСТ
    ' =========================
    cleanDoc = CleanID(wdDoc.Content.Text)

    ' =========================
    ' РАЗБИВАЕМ ПО §
    ' =========================
    sections = Split(wdDoc.Content.Text, "§")

    ' =========================
    ' ПОИСК ПО ID ВНУТРИ БЛОКОВ
    ' =========================
    For Each key In dict.Keys
        
        If InStr(cleanDoc, key) > 0 Then
            
            data = dict(key)
            parts = Split(data, "|")
            
            blockText = ""
            
            ' ищем блок, где есть ID
            For i = 0 To UBound(sections)
                
                If InStr(CleanID(sections(i)), key) > 0 Then
                    
                    blockText = Trim(sections(i))
                    Exit For
                    
                End If
                
            Next i
            
            ' =========================
            ' ЗАПИСЬ В EXCEL
            ' =========================
            
            ws.Cells(resRow, 1).Value = parts(0) ' ФИО
            ws.Cells(resRow, 2).Value = parts(1) ' ID
            ws.Cells(resRow, 3).Value = blockText ' ТОЛЬКО БЛОК §
            ws.Cells(resRow, 4).Value = fileName
            
            resRow = resRow + 1
            
        End If
        
    Next key

    wdDoc.Close False
    Set wdDoc = Nothing

End Sub










