Option Explicit

Dim dict As Object
Dim wdApp As Object

' =========================
' ОЧИСТКА ID
' =========================
Function CleanID(txt As String) As String
    
    txt = LCase(txt)
    
    txt = Replace(txt, " ", "")
    txt = Replace(txt, Chr(160), "")
    txt = Replace(txt, vbTab, "")
    txt = Replace(txt, vbCr, "")
    txt = Replace(txt, vbLf, "")
    txt = Replace(txt, "-", "")
    
    CleanID = txt

End Function


