Sub ДобавитьСотрудника()

    Dim wbDB As Workbook
    Dim wsBase As Worksheet, wsEdit As Worksheet
    
    Dim lastRowBase As Long, lastRowEdit As Long
    Dim newRow As Long, i As Long, j As Long
    Dim newID As Variant
    
    Dim dictID As Object
    Set dictID = CreateObject("Scripting.Dictionary")
    
    ' ===== КОЛОНКИ =====
    Const COL_ID = 1
    Const COL_FIO = 2
    Const COL_HISTORY = 28
    Const COL_DATE = 23
    
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    
    Set wsEdit = ThisWorkbook.Sheets(3)
    
    ' 🔹 Открываем базу
    Set wbDB = Workbooks.Open("C:\ПУТЬ\База.xlsx") ' ❗ укажи путь
    Set wsBase = wbDB.Sheets(1)
    
    ' 🔹 Собираем существующие ID
    lastRowBase = wsBase.Cells(wsBase.Rows.Count, COL_ID).End(xlUp).Row
    For i = 1 To lastRowBase
        dictID(wsBase.Cells(i, COL_ID).Value) = True
    Next i
    
    ' 🔹 Проходим по форме
    lastRowEdit = wsEdit.Cells(wsEdit.Rows.Count, COL_ID).End(xlUp).Row
    
    For i = 10 To lastRowEdit
        
        newID = wsEdit.Cells(i, COL_ID).Value
        
        ' Проверяем, что есть ID и ФИО
        If newID <> "" And wsEdit.Cells(i, COL_FIO).Value <> "" Then
            
            ' Проверка уникальности
            If dictID.exists(newID) Then
                MsgBox "ID " & newID & " уже существует в базе. Пропускаем строку " & i
                GoTo NextRow
            End If
            
            ' --- новая строка ---
            newRow = wsBase.Cells(wsBase.Rows.Count, COL_ID).End(xlUp).Row + 1
            dictID(newID) = True
            
            ' --- копируем все данные кроме истории ---
            For j = 1 To 28
                If j <> COL_HISTORY Then
                    wsBase.Cells(newRow, j).Value = wsEdit.Cells(i, j).Value
                End If
            Next j
            
            ' --- формируем историю ---
            wsBase.Cells(newRow, COL_HISTORY).Value = wsEdit.Cells(i, COL_DATE).Value & vbLf & wsEdit.Cells(i, COL_FIO).Value
            
            ' --- копируем форматирование предыдущей строки ---
            If newRow > 2 Then
                wsBase.Rows(newRow - 1).Copy
                wsBase.Rows(newRow).PasteSpecial Paste:=xlPasteFormats
            End If
            
        End If
        
NextRow:
    Next i
    
    ' 🔹 Сохраняем и закрываем базу
    wbDB.Save
    wbDB.Close
    
    ' 🔹 Очищаем форму
    wsEdit.Rows("10:" & wsEdit.Rows.Count).ClearContents
    
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    
    MsgBox "Новые сотрудники добавлены и история записана!"
    
End Sub