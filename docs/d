Sub СохранитьДанные()

    Dim wsBase As Worksheet, wsEdit As Worksheet, wsLog As Worksheet
    Dim baseArr As Variant
    Dim dict As Object, dictDay As Object
    
    Dim lastRowBase As Long, lastRowEdit As Long, lastRowLog As Long
    Dim i As Long, j As Long
    Dim ID As Variant
    
    Dim foundDateRow As Long
    Dim writeRow As Long
    Dim currentDate As String
    
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    
    Set wsBase = ThisWorkbook.Sheets(1)
    Set wsEdit = ThisWorkbook.Sheets(3)
    Set wsLog = ThisWorkbook.Sheets("Отработанные ID")
    
    ' ==============================
    ' 🔹 1. ЛОГИРОВАНИЕ ID (накопительно)
    ' ==============================
    
    Set dictDay = CreateObject("Scripting.Dictionary")
    currentDate = Format(Date, "dd.mm.yyyy")
    
    lastRowLog = wsLog.Cells(wsLog.Rows.Count, 1).End(xlUp).Row
    foundDateRow = 0
    
    ' ищем дату
    For i = lastRowLog To 1 Step -1
        If wsLog.Cells(i, 1).Value = currentDate Then
            foundDateRow = i
            Exit For
        End If
    Next i
    
    If foundDateRow <> 0 Then
        
        writeRow = foundDateRow + 1
        
        ' собираем уже записанные ID
        Do While wsLog.Cells(writeRow, 1).Value <> ""
            dictDay(wsLog.Cells(writeRow, 1).Value) = True
            writeRow = writeRow + 1
        Loop
        
    Else
        
        writeRow = lastRowLog + 2
        wsLog.Cells(writeRow, 1).Value = currentDate
        writeRow = writeRow + 1
        
    End If
    
    lastRowEdit = wsEdit.Cells(wsEdit.Rows.Count, 1).End(xlUp).Row
    
    For i = 10 To lastRowEdit
        
        ID = wsEdit.Cells(i, 1).Value
        
        If ID <> "" Then
            If Not dictDay.exists(ID) Then
                
                wsLog.Cells(writeRow, 1).Value = ID
                dictDay(ID) = True
                writeRow = writeRow + 1
                
            End If
        End If
        
    Next i
    
    ' ==============================
    ' 🔹 2. СОХРАНЕНИЕ В БАЗУ
    ' ==============================
    
    lastRowBase = wsBase.Cells(wsBase.Rows.Count, 1).End(xlUp).Row
    
    ' загружаем базу в массив
    baseArr = wsBase.Range(wsBase.Cells(1, 1), wsBase.Cells(lastRowBase, 27)).Value
    
    ' словарь ID → строка
    Set dict = CreateObject("Scripting.Dictionary")
    
    For i = 1 To UBound(baseArr, 1)
        dict(baseArr(i, 1)) = i
    Next i
    
    ' обновляем массив
    For i = 10 To lastRowEdit
        
        ID = wsEdit.Cells(i, 1).Value
        
        If ID <> "" Then
            If dict.exists(ID) Then
                
                For j = 1 To 27
                    baseArr(dict(ID), j) = wsEdit.Cells(i, j).Value
                Next j
                
            End If
        End If
        
    Next i
    
    ' записываем обратно
    wsBase.Range(wsBase.Cells(1, 1), wsBase.Cells(lastRowBase, 27)).Value = baseArr
    
    ' ==============================
    ' 🔹 3. ОЧИСТКА ФОРМЫ
    ' ==============================
    
    wsEdit.Rows("10:" & wsEdit.Rows.Count).ClearContents
    
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    
    MsgBox "Данные сохранены, ID записаны!"
    
End Sub






Sub СинхронизацияКомандировок()

    Dim wbMain As Workbook, wbTrip As Workbook
    Dim wsMain As Worksheet, wsTrip As Worksheet, wsDay As Worksheet
    
    Dim dictOld As Object, dictNew As Object
    
    Dim lastRowMain As Long, lastRowTrip As Long
    Dim i As Long, ID As Variant
    
    Dim todaySheet As String
    Dim rowDay As Long, rowWrite As Long
    
    ' --- КОЛОНКИ В ГЛАВНОЙ ТАБЛИЦЕ ---
    Const COL_ID = 4
    Const COL_NAME = 2
    Const COL_DEPT = 5
    Const COL_POS = 6
    Const COL_TRIP = 27
    
    ' --- КОЛОНКИ В ШАБЛОНЕ (ЛИСТ ДНЯ) ---
    Const DAY_NAME = 1   ' ФИО
    Const DAY_DEPT = 2   ' Отдел
    Const DAY_POS = 3    ' Должность
    Const DAY_TYPE = 4   ' Тип (уехал/вернулся)
    Const DAY_DATE = 5   ' Дата
    
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    
    Set wbMain = ThisWorkbook
    Set wsMain = wbMain.Sheets(1)
    
    ' 👉 УКАЖИ ПУТЬ
    Set wbTrip = Workbooks.Open("C:\ПУТЬ\Командировка.xlsx")
    
    Set wsTrip = wbTrip.Sheets("Полный список")
    
    todaySheet = Day(Date)
    Set wsDay = wbTrip.Sheets(todaySheet)
    
    ' --- старый список ---
    Set dictOld = CreateObject("Scripting.Dictionary")
    
    lastRowTrip = wsTrip.Cells(wsTrip.Rows.Count, COL_ID).End(xlUp).Row
    
    For i = 2 To lastRowTrip
        dictOld(wsTrip.Cells(i, COL_ID).Value) = True
    Next i
    
    ' --- новый список ---
    Set dictNew = CreateObject("Scripting.Dictionary")
    
    lastRowMain = wsMain.Cells(wsMain.Rows.Count, COL_ID).End(xlUp).Row
    
    For i = 2 To lastRowMain
        If wsMain.Cells(i, COL_TRIP).Value = "+" Then
            dictNew(wsMain.Cells(i, COL_ID).Value) = i
        End If
    Next i
    
    ' --- первая пустая строка в шаблоне ---
    rowDay = wsDay.Cells(wsDay.Rows.Count, DAY_NAME).End(xlUp).Row + 1
    
    ' ===== УЕХАЛИ =====
    For Each ID In dictNew.Keys
        If Not dictOld.exists(ID) Then
            
            i = dictNew(ID)
            
            wsDay.Cells(rowDay, DAY_NAME).Value = wsMain.Cells(i, COL_NAME).Value
            wsDay.Cells(rowDay, DAY_DEPT).Value = wsMain.Cells(i, COL_DEPT).Value
            wsDay.Cells(rowDay, DAY_POS).Value = wsMain.Cells(i, COL_POS).Value
            wsDay.Cells(rowDay, DAY_TYPE).Value = "Уехал"
            wsDay.Cells(rowDay, DAY_DATE).Value = Date
            
            rowDay = rowDay + 1
            
        End If
    Next ID
    
    ' ===== ВЕРНУЛИСЬ =====
    For Each ID In dictOld.Keys
        If Not dictNew.exists(ID) Then
            
            wsDay.Cells(rowDay, DAY_NAME).Value = "ID: " & ID
            wsDay.Cells(rowDay, DAY_TYPE).Value = "Вернулся"
            wsDay.Cells(rowDay, DAY_DATE).Value = Date
            
            rowDay = rowDay + 1
            
        End If
    Next ID
    
    ' --- очищаем список ---
    wsTrip.Rows("2:" & wsTrip.Rows.Count).ClearContents
    
    ' --- записываем новый список ---
    rowWrite = 2
    
    For Each ID In dictNew.Keys
        
        i = dictNew(ID)
        
        wsTrip.Cells(rowWrite, 1).Value = wsMain.Cells(i, COL_ID).Value
        wsTrip.Cells(rowWrite, 2).Value = wsMain.Cells(i, COL_NAME).Value
        wsTrip.Cells(rowWrite, 3).Value = wsMain.Cells(i, COL_DEPT).Value
        wsTrip.Cells(rowWrite, 4).Value = wsMain.Cells(i, COL_POS).Value
        
        rowWrite = rowWrite + 1
        
    Next ID
    
    wbTrip.Save
    wbTrip.Close
    
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    
    MsgBox "Командировки обновлены!"
    
End Sub