
Sub ЗаписатьДанныеЕслиНетСегодня(ID As String, val1 As Variant, val2 As Variant, val3 As Variant, val4 As Variant)

    Dim wsLog As Worksheet
    Dim lastRow As Long
    Dim j As Long
    Dim todayStr As String
    Dim existsToday As Boolean
    
    Set wsLog = ThisWorkbook.Sheets("Отработанные ID")
    
    todayStr = Format(Date, "dd.mm.yyyy")
    lastRow = wsLog.Cells(wsLog.Rows.Count, 1).End(xlUp).Row
    
    existsToday = False
    
    ' 🔥 проверка дубля за сегодня
    For j = 2 To lastRow
        
        If Format(wsLog.Cells(j, 1).Value, "dd.mm.yyyy") = todayStr _
        And wsLog.Cells(j, 2).Value = ID Then
            
            existsToday = True
            Exit For
            
        End If
        
    Next j
    
    ' 🔥 если нет — записываем
    If Not existsToday Then
        
        lastRow = lastRow + 1
        
        wsLog.Cells(lastRow, 1).Value = Date
        wsLog.Cells(lastRow, 2).Value = ID
        wsLog.Cells(lastRow, 3).Value = val1
        wsLog.Cells(lastRow, 4).Value = val2
        wsLog.Cells(lastRow, 5).Value = val3
        wsLog.Cells(lastRow, 6).Value = val4
        
    End If

End Sub