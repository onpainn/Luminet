Sub ПоказатьДанные()

    Dim wbDB As Workbook
    Dim wsBase As Worksheet, wsEdit As Worksheet
    
    Dim baseArr As Variant
    Dim lastRowBase As Long, lastRowEdit As Long
    
    Dim i As Long, j As Long, k As Long
    Dim found As Boolean
    
    Dim searchID As String
    Dim searchFIO As String
    Dim searchEmail As String
    
    ' ===== КОЛОНКИ =====
    Const COL_ID = 1
    Const COL_FIO = 2
    Const COL_EMAIL = 10 ' ❗ укажи свою
    
    Application.ScreenUpdating = False
    
    Set wsEdit = ThisWorkbook.Sheets(3)
    
    ' 🔹 открыть базу
    Set wbDB = Workbooks.Open("C:\ПУТЬ\База.xlsx")
    Set wsBase = wbDB.Sheets(1)
    
    ' 🔹 загрузка базы
    lastRowBase = wsBase.Cells(wsBase.Rows.Count, 1).End(xlUp).Row
    baseArr = wsBase.Range(wsBase.Cells(1, 1), wsBase.Cells(lastRowBase, 28)).Value
    
    ' 🔹 строки формы
    lastRowEdit = wsEdit.Cells(wsEdit.Rows.Count, 1).End(xlUp).Row
    
    For i = 10 To lastRowEdit
        
        searchID = Trim(wsEdit.Cells(i, COL_ID).Value)
        searchFIO = Trim(wsEdit.Cells(i, COL_FIO).Value)
        searchEmail = Trim(wsEdit.Cells(i, COL_EMAIL).Value)
        
        found = False
        
        If searchID <> "" Or searchFIO <> "" Or searchEmail <> "" Then
            
            For k = 1 To UBound(baseArr, 1)
                
                ' 🔥 ПОИСК ПО КОНКРЕТНОЙ КОЛОНКЕ
                If (searchID <> "" And baseArr(k, COL_ID) = searchID) _
                Or (searchFIO <> "" And LCase(baseArr(k, COL_FIO)) = LCase(searchFIO)) _
                Or (searchEmail <> "" And LCase(baseArr(k, COL_EMAIL)) = LCase(searchEmail)) Then
                    
                    ' копируем строку
                    For j = 1 To 28
                        wsEdit.Cells(i, j).Value = baseArr(k, j)
                    Next j
                    
                    found = True
                    Exit For
                    
                End If
                
            Next k
            
            ' подсветка если не найден
            If Not found Then
                wsEdit.Cells(i, COL_ID).Interior.Color = RGB(255, 200, 200)
            Else
                wsEdit.Cells(i, COL_ID).Interior.ColorIndex = 0
            End If
            
        End If
        
    Next i
    
    wbDB.Close False
    
    Application.ScreenUpdating = True
    
    MsgBox "Данные загружены!"
    
End Sub









Sub UpdateStatuses_NoReplace()

    Dim wbSource As Workbook, wbTarget As Workbook
    Dim wsSource As Worksheet, wsTarget As Worksheet
    Dim fileSource As String, fileTarget As String
    
    Dim dict As Object
    Set dict = CreateObject("Scripting.Dictionary")
    
    Dim arrIDSource As Variant, arrStatusSource As Variant
    Dim arrIDTarget As Variant, arrStatusTarget As Variant
    
    Dim lastRowSource As Long, lastRowTarget As Long
    Dim i As Long, id As String

    ' 🚀 Ускорение
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    Application.EnableEvents = False

    ' Выбор файлов
    fileSource = Application.GetOpenFilename("Excel Files (*.xlsx), *.xlsx", , "Выберите главный файл")
    If fileSource = "False" Then GoTo ExitHandler
    
    fileTarget = Application.GetOpenFilename("Excel Files (*.xlsx), *.xlsx", , "Выберите файл для обновления")
    If fileTarget = "False" Then GoTo ExitHandler

    ' Открытие
    Set wbSource = Workbooks.Open(fileSource)
    Set wbTarget = Workbooks.Open(fileTarget)

    Set wsSource = wbSource.Sheets(1)
    Set wsTarget = wbTarget.Sheets(1)

    ' Последние строки
    lastRowSource = wsSource.Cells(wsSource.Rows.Count, 5).End(xlUp).Row
    lastRowTarget = wsTarget.Cells(wsTarget.Rows.Count, 6).End(xlUp).Row

    ' Загружаем только нужные колонки
    arrIDSource = wsSource.Range("E2:E" & lastRowSource).Value
    arrStatusSource = wsSource.Range("J2:J" & lastRowSource).Value

    arrIDTarget = wsTarget.Range("F2:F" & lastRowTarget).Value
    arrStatusTarget = wsTarget.Range("M2:M" & lastRowTarget).Value

    ' Словарь
    For i = 1 To UBound(arrIDSource, 1)
        id = LCase(Trim(arrIDSource(i, 1)))
        If id <> "" Then
            dict(id) = arrStatusSource(i, 1)
        End If
    Next i

    ' Обновление
    For i = 1 To UBound(arrIDTarget, 1)
        id = LCase(Trim(arrIDTarget(i, 1)))
        If dict.exists(id) Then
            arrStatusTarget(i, 1) = dict(id)
        End If
    Next i

    ' Запись обратно
    wsTarget.Range("M2").Resize(UBound(arrStatusTarget, 1), 1).Value = arrStatusTarget

    MsgBox "Готово (ещё быстрее)"

ExitHandler:
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    Application.EnableEvents = True

End Sub





Sub LoadByDate_Smart()

    Dim ws1 As Worksheet, ws2 As Worksheet
    Dim lastRow As Long, i As Long
    Dim pasteRow As Long
    Dim userDate As Date
    
    Dim cellText As String
    Dim arr As Variant
    Dim part As Variant
    Dim found As Boolean
    
    Set ws1 = ThisWorkbook.Sheets("Лист1")
    Set ws2 = ThisWorkbook.Sheets("Лист2")
    
    ' Проверка даты
    If Not IsDate(ws2.Range("B1").Value) Then
        MsgBox "Введите корректную дату в B1!", vbExclamation
        Exit Sub
    End If
    
    userDate = Int(ws2.Range("B1").Value)
    
    ws2.Range("A2:P100000").ClearContents
    pasteRow = 2
    
    lastRow = ws1.Cells(ws1.Rows.Count, "I").End(xlUp).Row
    
    For i = 1 To lastRow
        
        If Not IsError(ws1.Cells(i, "I").Value) Then
            
            cellText = CStr(ws1.Cells(i, "I").Value)
            
            ' Разбиваем строку (учитываем разные разделители)
            cellText = Replace(cellText, ",", " ")
            cellText = Replace(cellText, ";", " ")
            cellText = Replace(cellText, "/", " ")
            cellText = Replace(cellText, "-", " ")
            
            arr = Split(cellText, " ")
            
            found = False
            
            For Each part In arr
                
                If IsDate(part) Then
                    
                    If Int(CDate(part)) = userDate Then
                        found = True
                        Exit For
                    End If
                    
                End If
                
            Next part
            
            If found Then
                
                ws2.Range(ws2.Cells(pasteRow, "A"), ws2.Cells(pasteRow, "P")).Value = _
                ws1.Range(ws1.Cells(i, "A"), ws1.Cells(i, "P")).Value
                
                pasteRow = pasteRow + 1
                
            End If
            
        End If
        
    Next i

    MsgBox "Умный поиск завершён 🚀"

End Sub